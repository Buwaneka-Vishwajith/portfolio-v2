---
/**
 * NudgeDemo: a looping, CSS-drawn recreation of the Nudge Chrome extension
 * (github.com/Buwaneka-Vishwajith/Ai-browser-popup) for the big bento card.
 *
 * Story: reading an article → select a sentence → ⌘⇧Space → the glass command palette
 * springs in → "Explain simply…" is typed and run → Thinking… → the answer streams in.
 *
 * No images or video: plain HTML + CSS, and a small script that runs the timeline.
 * - Plays only while on screen; restarts from the top when it scrolls back in.
 * - prefers-reduced-motion: shows a single still frame (palette open with the answer).
 * - Everything is sized in `em` off the card width, so it scales like a video.
 * To change the words, edit the ARTICLE / PROMPT / ANSWER strings below.
 */
const SITE = 'kubernetes.io/docs/concepts';
const TITLE = 'How Kubernetes keeps your apps alive';
const BEFORE = 'Every cluster has a control plane. ';
const SELECTED =
  'The scheduler watches for newly created Pods and assigns each one to a node, while controllers continuously reconcile the actual state with the desired state.';
const AFTER = ' If a node fails, its workloads are rescheduled automatically.';
const PROMPT = 'Explain simply';
const PRESET = 'Explain simply in simple terms';
const ANSWER =
  "Think of Kubernetes as a manager for your apps. It decides which machine runs each one, keeps checking they're healthy, and moves them somewhere else if a machine breaks.";
---

<div class="nudge-demo" aria-hidden="true" data-nudge-demo data-prompt={PROMPT} data-answer={ANSWER}>
  <div class="stage">
    <!-- Browser window -->
    <div class="chrome">
      <span class="url"><span class="lock">●</span>{SITE}</span>
    </div>

    <div class="page">
      <p class="crumb">Concepts / Overview</p>
      <p class="title">{TITLE}</p>
      <p class="body">
        {BEFORE}<span class="sel" data-sel>{SELECTED}</span>{AFTER}
      </p>
      <div class="bars">
        <i style="width:96%"></i><i style="width:88%"></i><i style="width:92%"></i><i style="width:54%"></i>
      </div>
      <div class="bars">
        <i style="width:90%"></i><i style="width:72%"></i>
      </div>
    </div>

    <!-- Shortcut hint -->
    <div class="keys">
      <kbd>⌘</kbd><kbd>⇧</kbd><kbd class="wide">Space</kbd>
    </div>

    <!-- Nudge palette (mirrors the real extension: dark glass, glow border) -->
    <div class="palette">
      <div class="glow"></div>
      <div class="sec head">
        <p class="label">Selected text</p>
        <p class="quote">"{SELECTED.slice(0, 92)}…"</p>
      </div>
      <div class="sec input">
        <span class="typed" data-typed></span><span class="caret"></span>
        <span class="placeholder">Type a command or ask anything…</span>
        <kbd class="esc">ESC</kbd>
      </div>
      <div class="list">
        <div class="item"><span class="hash">#</span>{PRESET}</div>
      </div>
      <div class="response">
        <div class="thinking"><span class="spin"></span>Thinking…</div>
        <p class="answer" data-answer-out></p>
      </div>
      <div class="foot">
        <span class="btn">New Command</span>
        <span class="right">
          <span class="btn copy" data-copy>Copy</span>
          <span class="btn close">Close</span>
        </span>
      </div>
    </div>

    <!-- macOS-style pointer -->
    <svg class="pointer" data-pointer viewBox="0 0 24 24" width="1.25em" height="1.25em">
      <path d="M5 2.5v17.2l4.3-4.2 2.9 6.6 2.9-1.3-2.9-6.5h6.1z" fill="#111" stroke="#fff" stroke-width="1.4" stroke-linejoin="round" />
    </svg>
  </div>
</div>

<style>
  /* Apple-style motion curves */
  .nudge-demo {
    --ease: cubic-bezier(0.32, 0.72, 0, 1); /* iOS sheet / spring-like settle */
    --ease-soft: cubic-bezier(0.25, 0.1, 0.25, 1);
    position: absolute;
    inset: 0;
    container-type: inline-size;
    overflow: hidden;
    border-radius: inherit;
    user-select: none;
    pointer-events: none;
  }
  .stage {
    position: absolute;
    inset: 0;
    font-size: calc(100cqw / 40); /* 16px when the media box is 640px wide */
    font-family: 'Inter Variable', 'Inter', system-ui, sans-serif;
    background: #e8eef6; /* the demo page's background */
    color: #1d1d1f;
  }

  /* Browser chrome */
  .chrome {
    display: flex;
    align-items: center;
    gap: 0.4em;
    height: 1.9em;
    padding: 0 0.8em;
    background: rgba(255, 255, 255, 0.35);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  .url {
    flex: 0 1 18em;
    display: flex;
    align-items: center;
    gap: 0.4em;
    padding: 0 0.6em;
    border-radius: 0.4em;
    background: rgba(255, 255, 255, 0.85);
    color: rgba(0, 0, 0, 0.5);
    font-size: 0.52em;
    height: 2.2em;
  }
  .lock { font-size: 0.6em; color: rgba(0, 0, 0, 0.3); }

  /* Article */
  .page { padding: 1.3em 2.2em 0; transition: filter 0.6s var(--ease-soft), opacity 0.6s var(--ease-soft); }
  .crumb { font-size: 0.5em; letter-spacing: 0.04em; text-transform: uppercase; color: rgba(0, 0, 0, 0.38); }
  .title { margin-top: 0.35em; font-size: 1.15em; font-weight: 650; letter-spacing: -0.02em; }
  .body { margin-top: 0.7em; font-size: 0.66em; line-height: 1.7; color: rgba(0, 0, 0, 0.62); max-width: 52em; }
  .sel {
    /* macOS text selection, swept left → right */
    background-image: linear-gradient(#b3d7ff, #b3d7ff);
    background-repeat: no-repeat;
    background-size: 0% 100%;
    color: inherit;
    transition: background-size 0.85s var(--ease-soft);
  }
  .bars { margin-top: 0.95em; display: grid; gap: 0.48em; }
  .bars i { display: block; height: 0.42em; border-radius: 1em; background: rgba(0, 0, 0, 0.07); }

  /* Shortcut keycaps */
  .keys {
    position: absolute;
    left: 50%;
    bottom: 1.2em;
    display: flex;
    gap: 0.35em;
    translate: -50% 0.6em;
    opacity: 0;
    scale: 0.94;
    filter: blur(4px);
    transition: opacity 0.45s var(--ease), translate 0.55s var(--ease), scale 0.55s var(--ease), filter 0.45s var(--ease);
  }
  .keys kbd {
    display: grid;
    place-items: center;
    min-width: 2em;
    height: 2em;
    padding: 0 0.5em;
    border-radius: 0.5em;
    background: linear-gradient(#fff, #f2f2f4);
    box-shadow: 0 0.1em 0 rgba(0, 0, 0, 0.12), 0 0.35em 0.9em -0.3em rgba(0, 0, 0, 0.25), inset 0 0 0 1px rgba(0, 0, 0, 0.07);
    font: 600 0.62em/1 'Inter Variable', system-ui, sans-serif;
    color: #333;
    transition: translate 0.14s var(--ease-soft), box-shadow 0.14s var(--ease-soft);
  }
  .keys kbd.wide { min-width: 4.4em; }

  /* Palette (dark glass like the real extension) */
  .palette {
    position: absolute;
    left: 31%;
    top: 5.6em;
    width: 17.5em;
    border-radius: 1em;
    background: rgba(18, 15, 23, 0.72);
    -webkit-backdrop-filter: blur(14px) saturate(1.5);
    backdrop-filter: blur(14px) saturate(1.5);
    box-shadow: 0 1.6em 3em -1em rgba(18, 15, 23, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    color: #fff;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    overflow: hidden;
    transform-origin: 30% 0%;
    opacity: 0;
    translate: 0 -0.5em;
    scale: 0.94;
    filter: blur(6px);
    transition: opacity 0.5s var(--ease), translate 0.7s var(--ease), scale 0.7s var(--ease), filter 0.5s var(--ease);
  }
  /* Slowly travelling highlight on the border (stand-in for the extension's BorderGlow) */
  .glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: conic-gradient(from var(--nd-angle, 0deg), transparent 0 62%, rgba(243, 243, 243, 0.9) 75%, rgba(232, 235, 197, 0.8) 82%, transparent 92%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: nd-spin 4s linear infinite;
    animation-play-state: paused;
    opacity: 0.7;
  }
  .sec { padding: 0.7em 0.85em; border-bottom: 1px solid rgba(255, 255, 255, 0.1); position: relative; }
  .label { font-size: 0.42em; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255, 255, 255, 0.4); font-weight: 500; }
  .quote {
    margin-top: 0.4em;
    font-size: 0.55em;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .input { display: flex; align-items: center; min-height: 2.3em; font-size: 1em; }
  .typed { font-size: 0.6em; color: rgba(255, 255, 255, 0.92); white-space: pre; }
  .caret { width: 1px; height: 0.8em; margin-left: 1px; background: rgba(255, 255, 255, 0.85); animation: nd-blink 1s steps(1) infinite; }
  .placeholder { position: absolute; left: 1.42em; font-size: 0.6em; color: rgba(255, 255, 255, 0.35); transition: opacity 0.15s; }
  .esc {
    margin-left: auto;
    font-size: 0.42em;
    padding: 0.1em 0.45em;
    border-radius: 0.35em;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.4);
  }
  .list {
    display: grid;
    grid-template-rows: 1fr;
    padding: 0.32em;
    transition: grid-template-rows 0.5s var(--ease), padding 0.5s var(--ease), opacity 0.3s var(--ease-soft);
  }
  .item {
    overflow: hidden;
    min-height: 0;
    display: flex;
    gap: 0.5em;
    align-items: center;
    padding: 0.75em 0.85em;
    border-radius: 1.1em;
    font-size: 0.58em;
    color: rgba(255, 255, 255, 0.82);
    transition: background-color 0.25s var(--ease-soft), scale 0.18s var(--ease-soft), padding 0.5s var(--ease);
  }
  .hash { color: rgba(255, 255, 255, 0.4); }
  .response {
    display: grid;
    grid-template-rows: 0fr;
    background: rgba(255, 255, 255, 0.03);
    transition: grid-template-rows 0.6s var(--ease);
  }
  .response > * { min-height: 0; overflow: hidden; }
  .thinking {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-size: 0.58em;
    color: rgba(255, 255, 255, 0.7);
    padding: 0;
    max-height: 0;
    opacity: 0;
    transition: max-height 0.35s var(--ease), padding 0.35s var(--ease), opacity 0.25s var(--ease-soft);
  }
  .spin {
    width: 1em;
    height: 1em;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    border-top-color: rgba(255, 255, 255, 0.85);
    animation: nd-spin-s 0.8s linear infinite;
  }
  .answer {
    font-size: 0.58em;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.95);
    padding: 0 1.45em;
    min-height: 0;
  }
  .answer :global(span) {
    display: inline;
    opacity: 0;
    filter: blur(3px);
    animation: nd-word 0.5s var(--ease) forwards;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 0.85em;
    max-height: 0;
    opacity: 0;
    border-top: 1px solid rgba(255, 255, 255, 0);
    background: rgba(255, 255, 255, 0.04);
    transition: max-height 0.5s var(--ease), padding 0.5s var(--ease), opacity 0.4s var(--ease-soft), border-color 0.4s;
  }
  .right { display: flex; gap: 0.4em; }
  .btn {
    font-size: 0.46em;
    font-weight: 500;
    padding: 0.55em 1.05em;
    border-radius: 0.7em;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.85);
    white-space: nowrap;
    transition: background-color 0.2s;
  }
  .btn.close { background: rgba(219, 68, 85, 0.12); color: #db4455; font-weight: 600; }

  .pointer {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 1em;
    translate: 42em 26em; /* parked off the bottom-right */
    opacity: 0;
    filter: drop-shadow(0 0.15em 0.25em rgba(0, 0, 0, 0.25));
    transition: translate 0.95s var(--ease), opacity 0.4s var(--ease-soft);
    will-change: translate;
  }

  /* ---------- Timeline states (classes set by the script) ---------- */
  .nudge-demo.is-pointer .pointer { opacity: 1; }
  .nudge-demo.is-drag .pointer { transition-duration: 0.85s; transition-timing-function: var(--ease-soft); }
  .nudge-demo.is-selected .sel { background-size: 100% 100%; }
  .nudge-demo.is-keys .keys { opacity: 1; translate: -50% 0; scale: 1; filter: blur(0); }
  .nudge-demo.is-pressed .keys kbd { translate: 0 0.12em; box-shadow: 0 0 0 rgba(0, 0, 0, 0.12), 0 0.15em 0.4em -0.3em rgba(0, 0, 0, 0.25), inset 0 0 0 1px rgba(0, 0, 0, 0.09); }
  .nudge-demo.is-open .page { filter: saturate(0.9); opacity: 0.88; }
  .nudge-demo.is-open .palette { opacity: 1; translate: 0 0; scale: 1; filter: blur(0); }
  .nudge-demo.is-open .glow { animation-play-state: running; }
  .nudge-demo.is-open .pointer { opacity: 0; }
  .nudge-demo.is-typing .placeholder { opacity: 0; }
  .nudge-demo.is-hl .item { background: rgba(255, 255, 255, 0.1); }
  .nudge-demo.is-enter .item { scale: 0.98; }
  .nudge-demo.is-run .list { grid-template-rows: 0fr; padding: 0 0.32em; opacity: 0; }
  .nudge-demo.is-run .item { padding-block: 0; }
  .nudge-demo.is-run .response { grid-template-rows: 1fr; }
  .nudge-demo.is-run .thinking { max-height: 3em; padding: 0.85em 1.45em; opacity: 1; }
  .nudge-demo.is-answer .thinking { max-height: 0; padding: 0 1.45em; opacity: 0; }
  .nudge-demo.is-answer .answer { padding: 0.85em 1.45em; }
  .nudge-demo.is-answer .foot { max-height: 3em; padding: 0.55em 0.85em; opacity: 1; border-top-color: rgba(255, 255, 255, 0.1); }
  .nudge-demo.is-copied .copy { background: rgba(255, 255, 255, 0.18); }
  .nudge-demo.is-out .palette { opacity: 0; translate: 0 -0.4em; scale: 0.96; filter: blur(6px); transition-duration: 0.45s; }
  .nudge-demo.is-out .sel { background-size: 0% 100%; transition-duration: 0.4s; }
  .nudge-demo.is-out .page { filter: none; opacity: 1; }

  @property --nd-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }
  @keyframes nd-spin { to { --nd-angle: 360deg; } }
  @keyframes nd-spin-s { to { rotate: 360deg; } }
  @keyframes nd-blink { 50% { opacity: 0; } }
  @keyframes nd-word { to { opacity: 1; filter: blur(0); } }

  /* Reduced motion: one still frame, no movement */
  @media (prefers-reduced-motion: reduce) {
    .nudge-demo *, .nudge-demo *::before { transition: none !important; animation: none !important; }
    .nudge-demo .answer :global(span) { opacity: 1; filter: none; }
  }
</style>

<script>
  const prefersReduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function setup(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';

    const prompt = root.dataset.prompt ?? '';
    const answer = root.dataset.answer ?? '';
    const stage = root.querySelector<HTMLElement>('.stage')!;
    const sel = root.querySelector<HTMLElement>('[data-sel]')!;
    const pointer = root.querySelector<SVGElement>('[data-pointer]')!;
    const typed = root.querySelector<HTMLElement>('[data-typed]')!;
    const out = root.querySelector<HTMLElement>('[data-answer-out]')!;
    const copy = root.querySelector<HTMLElement>('[data-copy]')!;
    const STATES = ['is-pointer', 'is-drag', 'is-selected', 'is-keys', 'is-pressed', 'is-open', 'is-typing', 'is-hl', 'is-enter', 'is-run', 'is-answer', 'is-copied', 'is-out'];

    let timers: number[] = [];
    let running = false;
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const on = (...c: string[]) => root.classList.add(...c);
    const off = (...c: string[]) => root.classList.remove(...c);

    // Positions are measured live (in em), so they stay right at any card size.
    const em = () => parseFloat(getComputedStyle(stage).fontSize) || 16;
    const pointAt = (x: number, y: number) => {
      const e = em();
      pointer.style.translate = `${x / e}em ${y / e}em`;
    };
    const selEdges = () => {
      const s = stage.getBoundingClientRect();
      const rects = sel.getClientRects();
      const first = rects[0];
      const last = rects[rects.length - 1];
      return {
        start: [first.left - s.left - 2, first.top - s.top + 1],
        end: [last.right - s.left - 2, last.top - s.top + 1],
      };
    };

    const words = answer.split(' ');
    const reset = () => {
      timers.forEach(clearTimeout);
      timers = [];
      off(...STATES);
      typed.textContent = '';
      out.textContent = '';
      copy.textContent = 'Copy';
      pointer.style.translate = '';
    };

    const stillFrame = () => {
      reset();
      on('is-selected', 'is-open', 'is-typing', 'is-run', 'is-answer');
      typed.textContent = prompt;
      out.innerHTML = words.map((w) => `<span>${w} </span>`).join('');
    };

    const play = () => {
      reset();
      const { start, end } = selEdges();
      at(300, () => { on('is-pointer'); pointAt(start[0], start[1]); });
      at(1350, () => { on('is-drag', 'is-selected'); pointAt(end[0], end[1]); });
      at(2350, () => { off('is-drag'); on('is-keys'); });
      at(2900, () => on('is-pressed'));
      at(3080, () => off('is-pressed'));
      at(3150, () => on('is-open'));
      at(3500, () => off('is-keys'));
      // type the prompt
      let t = 3900;
      at(t, () => on('is-typing'));
      [...prompt].forEach((ch, i) => at(t + 40 + i * 55, () => (typed.textContent += ch)));
      t += 40 + prompt.length * 55 + 250;
      at(t, () => on('is-hl'));
      at(t + 450, () => on('is-enter'));
      at(t + 600, () => { off('is-enter'); on('is-run'); });
      // stream the answer word by word
      t += 600 + 1100;
      at(t, () => on('is-answer'));
      words.forEach((w, i) =>
        at(t + 120 + i * 70, () => {
          const s = document.createElement('span');
          s.textContent = w + ' ';
          out.appendChild(s);
        }),
      );
      t += 120 + words.length * 70 + 900;
      at(t, () => { on('is-copied'); copy.textContent = 'Copied!'; });
      at(t + 700, () => { off('is-copied'); });
      at(t + 2200, () => on('is-out'));
      at(t + 3100, () => { if (running) play(); });
    };

    const io = new IntersectionObserver(([entry]) => {
      if (prefersReduced()) {
        stillFrame();
        return;
      }
      if (entry.isIntersecting && !running) {
        running = true;
        play();
      } else if (!entry.isIntersecting && running) {
        running = false;
        reset();
      }
    }, { threshold: 0.35 });
    io.observe(root);
  }

  const init = () => document.querySelectorAll<HTMLElement>('[data-nudge-demo]').forEach(setup);
  document.addEventListener('astro:page-load', init);
</script>
