---
import { site, socials, nav } from '../../data/site';
const year = new Date().getFullYear();
---

<footer class="section-dark px-[clamp(1.25rem,4vw,3rem)] pt-16 pb-8">
  <div class="grid gap-10 border-t border-paper/15 pt-10 sm:grid-cols-3">
    <div>
      <p class="font-serif text-3xl italic">{site.shortName}</p>
      <p class="mt-2 text-sm text-paper/60">{site.role}</p>
    </div>
    <nav aria-label="Footer">
      <ul class="space-y-2 text-sm">
        {nav.map((item) => <li><a class="hover:text-teal" href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <ul class="space-y-2 text-sm">
      <li><a class="hover:text-teal" href={`mailto:${site.email}`}>{site.email}</a></li>
      {socials.map((s) => (
        <li><a class="hover:text-teal" href={s.href} target="_blank" rel="noopener noreferrer">{s.label} ↗</a></li>
      ))}
    </ul>
  </div>
  <p class="mt-12 text-xs text-paper/40">© {year} {site.name}</p>
</footer>
