---
import { Image } from 'astro:assets';
import ink from '../../assets/inc.png';
import BlurText from '../react/BlurText/BlurText.jsx';
import ProximityText from '../react/ProximityText.jsx';
import ArticleCarousel from '../react/ArticleCarousel.jsx';
import { getSelectedArticles, formatMonth } from '../../lib/articles';
import { mediumProfile } from '../../data/articles';

// Which articles appear: src/data/articles.ts. Empty list = no section.
// Medium tags look like "web-development"; show them as "Web development".
const prettyTag = (tag?: string) =>
  tag ? tag.replace(/-/g, ' ').replace(/^./, (c) => c.toUpperCase()) : undefined;

const articles = getSelectedArticles().map((a) => ({
  ...a,
  subtitle: [formatMonth(a.published), prettyTag(a.tags[0])].filter(Boolean).join(' · '),
}));
---

{articles.length > 0 && (
  <section id="writing" class="section py-[clamp(2.5rem,6vw,5rem)]" aria-labelledby="writing-title">
    <header class="mb-6 text-center">
      <BlurText
      client:visible
      text="Notes"
      className="eyebrow mb-4 justify-center"
      effect="blur"
      direction="top"
      delay={60}
      stepDuration={0.35}
      blur={8}
      distance={16}
    />
      <h2 id="writing-title" aria-label="Occasionally, I write" class="headline text-[length:var(--text-display)]" data-split>
        <ProximityText client:visible text="Occasionally," /> <span class="headline-serif"><ProximityText client:visible text="I writ" variant="serif" /><span class="relative inline-block"><ProximityText client:visible text="e" variant="serif" /><Image src={ink} alt="" aria-hidden="true" format="webp" widths={[64, 128]} sizes="(min-width: 1720px) 62px, 3.6vw" quality={85} class="sticker-pop absolute -top-[-0.2em] -right-[0.16em] h-[1.2em] w-[1.2em] max-w-none select-none" /></span></span>
      </h2>
    </header>

    <!-- Visual carousel (WebGL). Click the centre card to read it on Medium. -->
    <!-- Full-bleed: the negative margins cancel the section's side padding -->
    <div class="writing-carousel relative -mx-[clamp(1.25rem,4vw,3rem)]" aria-hidden="true">
      <ArticleCarousel client:visible articles={articles} />
    </div>

    <!-- The same articles as plain links, hidden visually: for screen readers and search engines. -->
    <ul class="sr-only">
      {articles.map((a) => (
        <li>
          <a href={a.link} target="_blank" rel="noopener noreferrer" class="group flex items-baseline justify-between gap-6 py-4 hover:text-ink-soft">
            <span class="font-medium">{a.title}</span>
            <span class="shrink-0 font-mono text-xs text-ink-soft">{a.subtitle} <span aria-hidden="true">↗</span></span>
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-10 text-center">
      <a href={mediumProfile} target="_blank" rel="noopener noreferrer" class="pill bg-ink text-paper hover:-translate-y-0.5">
        More on Medium ↗
      </a>
    </p>
  </section>
)}
