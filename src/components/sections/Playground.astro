---
import { Image } from 'astro:assets';
// Bored frog sitting on the E of "Bored": cropped copy of src/assets/bored.png so its flat bottom is the image edge.
// bottom-[calc(100%-0.08em)] puts that edge on the top of the E (measured: the E's top is ~0.075em below its letter box).
import bored from '../../assets/stickers/bored.png';
import BlurText from '../react/BlurText/BlurText.jsx';
import ProximityText from '../react/ProximityText.jsx';
import MemoryGame from '../react/memory/MemoryGame.jsx';
// The game's rules live in src/components/react/memory/useMemoryGame.js, moved
// unchanged from the original src/components/react/Game.jsx (kept, not used).
// The v1 terminal is kept in src/components/react/Terminal.jsx but not shown
// for now. To bring it back: import Terminal from '../react/Terminal.jsx';
// and render <Terminal client:visible /> inside a .legacy-scope wrapper.
---

<section id="playground" class="section pt-[clamp(2.5rem,6vw,5rem)]" aria-labelledby="playground-title">
  <header class="mb-12 text-center">
    <h2 id="playground-title" aria-label="Bored already?" class="headline text-[length:var(--text-display)]" data-split>
      <ProximityText client:visible text="Bor" /><span class="relative inline-block"><ProximityText client:visible text="e" /><Image src={bored} alt="" aria-hidden="true" format="webp" widths={[64, 128]} sizes="(min-width: 1720px) 62px, 3.6vw" quality={85} class="sticker-pop absolute bottom-[calc(100%-0.08em)] left-1/2 ml-[0.02em] h-[0.34em] w-auto max-w-none -translate-x-1/2 origin-bottom select-none" /></span><ProximityText client:visible text="d" /> <span class="headline-serif"><ProximityText client:visible text="already?" variant="serif" /></span>
    </h2>
    <BlurText
      client:visible
      text="I watched people sweat over the GTA V RP thermite hack, so I made my own. Try it!"
      className="eyebrow mx-auto mt-6 max-w-3xl justify-center"
      boldClassName="text-[#fc734d]"
      effect="blur"
      direction="top"
      delay={30}
      stepDuration={0.35}
      blur={8}
      distance={16}
    />
  </header>

  <MemoryGame client:visible />
</section>
