---
import BlurText from '../react/BlurText/BlurText.jsx';
import ProximityText from '../react/ProximityText.jsx';
import { getCollection } from 'astro:content';
import ExperienceMenu from '../react/ExperienceMenu.jsx';
// The previous folder design is kept in src/components/react/ExperienceFolder.jsx
// (not used). To switch back, render <ExperienceFolder client:only="react" .../>.

// Edit src/data/experience.json to add, change or remove roles.
// Each role becomes a row: hover it to see the role and tools scroll past.
const roles = (await getCollection('experience', ({ data }) => !data.hidden))
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ id, data }) => ({ id, ...data }));
---

<section id="experience" class="section py-[clamp(2.5rem,6vw,5rem)]" aria-labelledby="experience-title">
  <header class="mb-12 text-center">
    <BlurText
      client:visible
      text="Work"
      className="eyebrow mb-4 justify-center"
      effect="blur"
      direction="top"
      delay={60}
      stepDuration={0.35}
      blur={8}
      distance={16}
    />
    <h2 id="experience-title" class="headline text-[length:var(--text-display)]" data-split>
      <ProximityText client:visible text="Experi" /><span class="headline-serif"><ProximityText client:visible text="ence" variant="serif" /></span>
    </h2>
  </header>

  <!-- Full-bleed: the negative margins cancel the section's side padding -->
  <div class="-mx-[clamp(1.25rem,4vw,3rem)] border-b border-ink/15">
    <ExperienceMenu client:visible roles={roles} />
  </div>

  <!-- Full details as plain text, hidden visually: for screen readers and search engines. -->
  <ul class="sr-only">
    {roles.map((role) => (
      <li>
        <h3>{role.position} at {role.company}</h3>
        <p>{role.period}</p>
        <ul>{role.description.map((line) => <li>{line}</li>)}</ul>
        <p>Tools: {role.technologies.join(', ')}</p>
      </li>
    ))}
  </ul>
</section>
