---
import { getCollection } from 'astro:content';
import BentoCard from '../ui/BentoCard.astro';
import SpotlightCard from '../react/SpotlightCard/SpotlightCard.jsx';
import { socials } from '../../data/site';

// Every project shows here. Tile size comes from `bento` in each
// project's .mdx file; order comes from `order`.
const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);

const github = socials.find((s) => s.label === 'GitHub')?.href;
---

<section id="work" class="section section-dark" aria-labelledby="work-title">
  <header class="mb-16 text-center">
    <p class="eyebrow mb-4">Things I've designed, built and shipped.</p>
    <h2 id="work-title" class="headline text-[length:var(--text-display)]" data-split>
      Selected <span class="headline-serif">work</span>
    </h2>
  </header>

  <div class="bento mx-auto grid max-w-6xl grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
    {projects.map((project) => <BentoCard project={project} />)}

    {github && (
      <SpotlightCard
        client:visible
        theme="dark"
        spotlightColor="#2dd4bf"
        intensity={0.18}
        className="bento-card group flex h-full flex-col justify-between"
        style={{ '--spotlight-card-surface': '#16171a' }}
      >
        <span class="font-mono text-[11px] uppercase tracking-wider text-paper/50">More on GitHub</span>
        <p class="headline mt-8 text-3xl text-paper">
          <a href={github} class="bento-link" target="_blank" rel="noopener noreferrer">
            See all <span class="headline-serif">repos</span> ↗
          </a>
        </p>
      </SpotlightCard>
    )}
  </div>
</section>
