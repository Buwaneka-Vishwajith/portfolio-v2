---
import { Image, getImage } from 'astro:assets';
import crown from '../../assets/crown.png';
import SpideyTrail from '../react/SpideyTrail.jsx';
import spideyPng from '../../assets/spidey.png';
// Small WebP for the bento grid's image trail (shown at 64px, so 160px covers retina).
const spidey = await getImage({ src: spideyPng, format: 'webp', width: 160, quality: 85 });
import BlurText from '../react/BlurText/BlurText.jsx';
import ProximityText from '../react/ProximityText.jsx';
import BentoCard from '../ui/BentoCard.astro';
import SeeAllCard from '../ui/SeeAllCard.astro';
import { getAllProjects, getHomeProjects } from '../../lib/projects';

// Which projects appear here, and in what order: src/data/home.ts
const home = await getHomeProjects();
const total = (await getAllProjects()).length;

// Slot sizes are fixed: the first project is always the big tile.
const slotSizes = ['large', 'small', 'small', 'small', 'small'] as const;

// "See all projects" stretches to fill whatever is left of its row, so the grid
// has no gaps with 1 to 5 projects. Literal class names so Tailwind keeps them.
const n = home.length;
// Tablet (2 columns): the small tiles pair up; an odd one out leaves one cell.
const mdSpan = (n - 1) % 2 === 0 ? 'md:col-span-2' : 'md:col-span-1';
// Desktop (3 columns): slots 2-3 sit beside the big tile, 4-5 go on the bottom row.
const lgSpan = ({ 1: 'lg:row-span-2', 2: '', 3: 'lg:col-span-3', 4: 'lg:col-span-2', 5: '' } as Record<number, string>)[n];
const seeAllSpan = `${mdSpan} ${lgSpan}`;
---

<section id="work" class="section pb-[clamp(2.5rem,6vw,5rem)]" aria-labelledby="work-title">
  <header class="mb-16 text-center">
    <BlurText
      client:visible
      text="Things I've designed & built."
      className="eyebrow mb-4 justify-center"
      effect="blur"
      direction="top"
      delay={60}
      stepDuration={0.35}
      blur={8}
      distance={16}
    />
    <h2 id="work-title" class="headline text-[length:var(--text-display)]" data-split>
      <ProximityText client:visible text="Selected" /> <span class="headline-serif"><span class="relative inline-block"><ProximityText client:visible text="work" variant="serif" /><Image
          src={crown}
          alt=""
          aria-hidden="true"
          format="webp"
          widths={[64, 128]}
          sizes="(min-width: 1720px) 62px, 3.6vw"
          quality={85}
          class="sticker-pop absolute -top-[0.54em] -right-[0.4em] h-[1.1em] w-[1.1em] rotate-[30deg] select-none"
        /></span></span>
    </h2>
  </header>

  <div class="relative mx-auto max-w-6xl" data-trail-zone>
    <div class="bento grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {home.map((project, i) => <BentoCard project={project} size={slotSizes[i]} />)}
      <SeeAllCard total={total} span={seeAllSpan} />
    </div>
    <!-- Spidey trail over the cards; it never blocks clicks. -->
    <div class="pointer-events-none absolute inset-0 z-20" aria-hidden="true">
      <SpideyTrail client:visible src={spidey.src} />
    </div>
  </div>
</section>
